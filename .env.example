POSTGRES_USER=agentbenchx
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=agentbenchx
DATABASE_URL=postgresql+psycopg://agentbenchx:local-development-only@localhost:55432/agentbenchx
REDIS_URL=redis://localhost:56379/0
STORAGE_ROOT=storage
ADMIN_TOKEN=replace-with-a-random-admin-token
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://api:8000
GIT_ALLOWED_HOSTS=["github.com"]
# Optional server-side SSH configuration; never transmitted to workers.
# GIT_SSH_COMMAND=ssh -o BatchMode=yes -o StrictHostKeyChecking=yes
# Communication budget (per API process); pre-ping remains enabled.
REAPER_INTERVAL_SECONDS=30
WORKER_OFFLINE_SECONDS=120
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT=5
# Local development default. For production select s3 and configure private storage.
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_ENDPOINT_URL= (HTTPS; omit for AWS S3)
# S3_REGION=auto (use the bucket region for AWS)
# S3_ACCESS_KEY_ID= (server secret)
# S3_SECRET_ACCESS_KEY= (server secret)
