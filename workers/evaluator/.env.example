# Template for a new worker only; preserve existing .env.worker and identity.
# Reuse the existing server endpoint. Never copy the control-plane .env here.
SERVER_URL=http://127.0.0.1:8000
WORKER_NAME="Mac #1"
# First launch registers automatically; identity.json retains the issued ID/token.
# No registration token or manual worker ID is needed.
# Optional alternative to the saved identity: supply both, using the server-issued UUID.
# WORKER_ID=
# WORKER_TOKEN=
WORKER_POLL_INTERVAL=5
WORKER_HEARTBEAT_INTERVAL=20
# Active lease keeps the legacy interval above. Idle liveness is independent.
WORKER_IDLE_HEARTBEAT_SECONDS=45
# Omit MIN to inherit WORKER_POLL_INTERVAL; max defaults to max(30, MIN).
WORKER_IDLE_POLL_MIN_SECONDS=5
WORKER_IDLE_POLL_MAX_SECONDS=30
WORKSPACE_ROOT=~/Library/Application Support/AgentBenchX
DOCKER_PLATFORM=linux/amd64
SANDBOX_CPUS=2
SANDBOX_MEMORY_MB=3072
BUILD_TIMEOUT_SECONDS=1800
GIT_ALLOWED_HOSTS=["github.com"]
